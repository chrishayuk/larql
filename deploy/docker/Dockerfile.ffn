# syntax=docker/dockerfile:1
#
# CPU FFN container — serves the FFN expert bank from RAM. No GPU dependencies,
# small image (~250–400 MB), runs anywhere. Mirrors deploy/fly/Dockerfile.
#
# Build:
#   docker build -f deploy/docker/Dockerfile.ffn -t larql-ffn:dev .
# Run (single-box dev):
#   docker run --rm -p 8080:8080 -v larql-vindex:/data larql-ffn:dev

FROM rust:1-slim AS builder
WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

RUN apt-get update && apt-get install -y \
        pkg-config libssl-dev protobuf-compiler cmake g++ libopenblas-dev \
    && RUSTFLAGS="-C target-feature=+avx2,+fma" \
        cargo build --release -p larql-server \
    && strip target/release/larql-server

FROM ubuntu:24.04
RUN apt-get update && \
    apt-get install -y \
        ca-certificates libssl3 curl python3 python3-pip libopenblas0 \
    && pip3 install --no-cache-dir --break-system-packages \
        huggingface_hub[hf_transfer] hf_transfer \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/larql-server /usr/local/bin/
COPY deploy/docker/start.sh /start.sh
RUN chmod +x /start.sh

ENV ROLE=ffn
EXPOSE 8080 8081
CMD ["/start.sh"]
