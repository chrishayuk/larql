{
  "$comment": "Architecture conformance sweep matrix. The unit of work is the FAMILY-GENERATION (project_vindex3_semantic_census), not the checkpoint and not the parameter count: sizes inside one generation collapse, generations do not. `role` says how far up the ladder a row is carried — `witness` rows are small enough to encode and reopen, `sibling` rows are planned from headers alone to test that size does not change the semantics.",
  "$envelopes_comment": "`envelope` names the SEMANTIC SHAPE a row is evidence about — the mixer first (attention / recurrence / conv), then how its FFN is sparse. It is an organising view, assigned per row so a generation that changes shape (DeepSeek V3.2 adds the indexer; Nemotron Nano-4B has no experts) is filed by what it declares, not by its lineage. `arch_sweep.py envelopes` derives the coverage table from these fields; nothing in the script names a model.",
  "envelopes": {
      "dense": {
          "name": "Dense Transformer",
          "shape": "softmax attention on every layer, dense FFN"
      },
      "hybrid-local-global": {
          "name": "Hybrid local ↔ global attention",
          "shape": "a per-layer schedule of sliding-window and full-context attention"
      },
      "sparse-moe": {
          "name": "Classic sparse MoE",
          "shape": "softmax attention, softmax top-k routing over a small expert bank"
      },
      "fine-grained-moe": {
          "name": "Fine-grained MoE",
          "shape": "sigmoid or biased routing over a large expert bank, usually with a shared expert"
      },
      "mla-moe": {
          "name": "MLA + MoE",
          "shape": "latent-compressed KV attention over a routed expert bank"
      },
      "sparse-indexed-mla-moe": {
          "name": "Sparse-indexed / DSA + MLA + MoE",
          "shape": "a learned indexer selects the keys each query attends to"
      },
      "linear-attention-hybrid": {
          "name": "Linear-attention hybrid",
          "shape": "gated DeltaNet recurrence interleaved with full attention"
      },
      "kda-mla": {
          "name": "KDA + MLA",
          "shape": "Kimi Delta Attention recurrence interleaved with latent attention"
      },
      "ssm": {
          "name": "Pure SSM",
          "shape": "Mamba-2 recurrence on every layer"
      },
      "ssm-attention": {
          "name": "SSM + attention",
          "shape": "Mamba recurrence interleaved with attention"
      },
      "ssm-attention-latent-moe-mtp": {
          "name": "SSM + attention + latent MoE + MTP",
          "shape": "Mamba-2 and attention layers with a latent-projected expert bank and a prediction head"
      },
      "conv-attention-hybrid": {
          "name": "Conv + attention hybrid",
          "shape": "gated short convolutions interleaved with attention"
      }
  },
